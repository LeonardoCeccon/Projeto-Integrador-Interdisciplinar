# Copie para .env e ajuste. Nunca versione o .env real.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=labagenda
DB_USER=labagenda_app
DB_PASSWORD=troque-esta-senha
# Em produção com HTTPS:
SECURE_COOKIES=1
# Banco em nuvem com SSL (ex.: Aiven): caminho do certificado CA baixado no painel
DB_SSL_CA=
# Opcional: senha do técnico criada pela carga inicial (use uma senha forte em produção)
SEED_SENHA_TECNICO=
